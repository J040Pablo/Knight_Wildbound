# ==========================================
# Standard Unity .gitignore
# ==========================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# Asset store packages
/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / Rider / VS Code files
.vs/
.idea/
.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.opendb
/*.idb
/*.VC.db

# Unity auto-generated source code files
[Aa]ssets/Plugins/Editor/JetBrains*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
sysinfo.txt

# Crash reports
crashreport.out
*.dmp
